# Settings for ONE product. Do not commit the filled .env file.
AUTH_ORIGIN=https://your-product.example
AUTH_TELEGRAM_CLIENT_ID=replace_with_login_client_id
# OIDC Client Secret from BotFather Login Widget, NOT a Bot API token.
AUTH_TELEGRAM_CLIENT_SECRET=replace_with_login_client_secret
AUTH_COOKIE_NAME=__Host-your_product_session
AUTH_SESSION_SECONDS=604800
AUTH_DATABASE_URL=sqlite+aiosqlite:///./auth.db
AUTH_DEVELOPMENT=false

# For HTTP-only localhost development (Telegram acceptance of the URL must be verified):
# AUTH_ORIGIN=http://localhost:8000
# AUTH_COOKIE_NAME=your_product_session
# AUTH_DEVELOPMENT=true

# For a separate product-owned PostgreSQL database:
# AUTH_DATABASE_URL=postgresql+asyncpg://auth_user:password@127.0.0.1:5432/product_db
